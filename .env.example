# Copy to .env and adjust. Never commit .env.

# --- Service desk (simulated legacy ticket system) ---------------------------------------------
# Shared secret between the app and the service desk. Change it outside local development.
SERVICEDESK_API_KEY=dev-servicedesk-key
# Host port (loopback only) to inspect the service at http://localhost:8100/docs
SERVICEDESK_PORT=8100
# Chance (0 to 1) that a call fails with 503, imitating the unstable legacy system. 0 disables it.
SERVICEDESK_FLAKY_RATE=0.1
# Artificial latency in milliseconds, "min-max". Empty disables it.
SERVICEDESK_LATENCY_MS=40-250
# 1 enables /admin (force an outage, reload sample data) and the OpenAPI docs.
SERVICEDESK_ADMIN=1

# --- Web app -------------------------------------------------------------------------------------
# Signs the session cookie. At least 32 characters; generate one with: openssl rand -hex 32
SESSION_SECRET=dev-only-session-secret-change-before-deploying
# Host port of the app: http://localhost:3000
WEB_PORT=3000
# Messages (employee + assistant) a chat session may hold before a new one is needed.
CHAT_MESSAGE_LIMIT=30

# The variables for the agent (LLM provider and keys) arrive with the agent part.
